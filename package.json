{
  "name": "wmt-desktop",
  "version": "1.0.123",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "dev:web": "vite --host",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "dev:tauri": "tauri dev",
    "build": "vite build",
    "build:tauri": "tauri build",
    "test": "vitest run",
    "test:backend": "python -m unittest discover -s backend/tests -v",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write package.json vite.config.ts tsconfig.json client/src",
    "format:check": "prettier --check package.json vite.config.ts tsconfig.json client/src",
    "verify": "pwsh -NoProfile -File ./scripts/verify.ps1"
  },
  "dependencies": {
